# 이 파일을 backend/.env로 복사해서 실제 값을 채운다. .env는 .gitignore에 걸려있어 커밋되지 않음.
# (실행: cp .env.example .env)

# --- DB (PostgreSQL, B/김재우 담당 — 로컬은 docker-compose 값과 맞추기) ---
DATABASE_URL=postgresql://tangtang:tangtang@localhost:5432/tangtang

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- ODsay LAB 경로탐색 API ---
ODSAY_API_KEY=
ODSAY_DAILY_QUOTA=1000

# --- 화면 하단 버전 배너 (CLAUDE.md §12, 6개 필드 중 4개 — client_ip/x-forwarded-for는 요청에서 읽음) ---
SERVER_VERSION=0.1.0
SERVER_NAME=tangtang-api-local
# 로컬 개발 중엔 의미 없는 값 — 배포되면 실제 서버 IP로 교체 (아래 답변 참고)
SERVER_IP=127.0.0.1
