# 이 파일을 backend/.env로 복사해서 실제 값을 채운다. .env는 .gitignore에 걸려있어 커밋되지 않음.
# (실행: cp .env.example .env)

# DB (PostgreSQL 16) — core/db.py가 이 개별 변수들을 읽는다(DATABASE_URL 통짜 문자열은
# 어떤 코드도 파싱하지 않으니 쓰지 않는다. 로컬은 docker-compose 값과 맞추기).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bium
DB_USER=bium
DB_PASSWORD=bium

# Redis — core/redis.py가 이 개별 변수들을 읽는다.
REDIS_HOST=localhost
REDIS_PORT=6379

# ODsay LAB 경로탐색 API
ODSAY_API_KEY=
# 실측 30(문서상 1,000이었으나 2026-08-19 라이브 테스트로 정정, CLAUDE.md §3 참고)
ODSAY_DAILY_QUOTA=30

# 전국 공영자전거 실시간 정보 API (행정안전부 한국지역정보개발원, data.go.kr)
# 국토교통부 API들과 같은 공공데이터포털 계정의 서비스키를 그대로 쓴다.
# 포털에서 복사한 URL-인코딩된 키 그대로 붙여넣으면 된다(코드에서 디코딩해서 사용).
BIKE_STOCK_API_KEY=

# 자전거 도로 경로 안내 (Openrouteservice, openrouteservice.org 무료 티어)
# 무료 API 키를 그대로 넣으면 된다(공공데이터포털 키와 달리 디코딩 불필요).
# 무료 티어 쿼터: 일일 2,000건 — 동일 출발/도착 좌표는 Redis에 24시간 캐싱해서 아낀다.
ORS_API_KEY=

# 로그인 세션(JWT, backend.md §12)
# 로그인 인증 토큰 서명 비밀키. 반드시 실제 배포 전에 무작위 값으로 교체할 것 —
# 커밋된 기본값을 그대로 쓰면 누구나 유효한 토큰을 위조할 수 있음.
JWT_SECRET=change-me-before-deploy

# 도보 구간 실제 경로 (SK Tmap 보행자경로안내 API, backend.md §13)
# 비어있으면 도보 구간 polyline을 조회하지 않고 조용히 건너뛴다(직선 폴백) — 발급 후 채우면 됨.
TMAP_APP_KEY=

# 카카오 로컬(키워드 검색) REST API — JS 키와 같은 카카오 앱에서 발급되는 별도 키.
# 지하철 노선도(SubwayLineDiagram) 커버리지 확장용 역 좌표 일괄 지오코딩 스크립트에서만
# 1회성으로 사용(프론트 런타임에서는 안 씀 — 프론트는 JS 키로 카카오맵 SDK만 사용).
KAKAO_REST_API_KEY=

# 화면 하단 공용 배너 (GET /api/v1/system/meta)
FRONT_VERSION=0.1.0
SERVER_VERSION=0.1.0
# SERVER_NAME/SERVER_IP는 비워두면 인스턴스 자신의 실제 hostname/IP로 자동 대체된다.
# ASG로 API 서버가 여러 대 뜨는 배포 환경(같은 .env 공유)에서는 반드시 비워둘 것 —
# 고정값을 넣으면 모든 인스턴스가 같은 값을 보여줘서 "어느 서버가 응답했는지" 확인이 안 된다.
SERVER_NAME=
SERVER_IP=
