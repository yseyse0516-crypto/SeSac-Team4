# DB (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tangtang
DB_USER=tangtang
DB_PASSWORD=tangtang

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# ODsay LAB 경로탐색 API
ODSAY_API_KEY=
ODSAY_DAILY_QUOTA=1000

# 전국 공영자전거 실시간 정보 API (행정안전부 한국지역정보개발원, data.go.kr)
# 국토교통부 API들과 같은 공공데이터포털 계정의 서비스키를 그대로 쓴다.
# 포털에서 복사한 URL-인코딩된 키 그대로 붙여넣으면 된다(코드에서 디코딩해서 사용).
BIKE_STOCK_API_KEY=

# 자전거 도로 경로 안내 (Openrouteservice, openrouteservice.org 무료 티어)
# 무료 API 키를 그대로 넣으면 된다(공공데이터포털 키와 달리 디코딩 불필요).
# 무료 티어 쿼터: 일일 2,000건 — 동일 출발/도착 좌표는 Redis에 24시간 캐싱해서 아낀다.
ORS_API_KEY=

# 화면 하단 공용 배너 (GET /api/v1/system/meta)
FRONT_VERSION=0.1.0
SERVER_VERSION=0.1.0
# SERVER_NAME/SERVER_IP는 비워두면 인스턴스 자신의 실제 hostname/IP로 자동 대체된다.
# ASG로 API 서버가 여러 대 뜨는 배포 환경(같은 .env 공유)에서는 반드시 비워둘 것 —
# 고정값을 넣으면 모든 인스턴스가 같은 값을 보여줘서 "어느 서버가 응답했는지" 확인이 안 된다.
SERVER_NAME=
SERVER_IP=
